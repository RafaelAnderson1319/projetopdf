# Configure estas variáveis no ambiente do servidor. Nunca publique as chaves reais.
PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
WONDERLEARN_DATA=./private
WONDERLEARN_ADMIN_PASSWORD=troque-por-uma-senha-forte
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-publishable-ou-anon
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Ative Google em Authentication > Providers e cadastre no Supabase a URL de retorno da aplicação:
# http://localhost:3000/account e http://127.0.0.1:3000/account
# No Google Cloud, o URI de redirecionamento autorizado é https://<projeto>.supabase.co/auth/v1/callback

