{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/account",
      "destination": "/account.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/dispatch?__path=/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/dispatch?__path=/auth/:path*"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "maxDuration": 60
    }
  }
}
