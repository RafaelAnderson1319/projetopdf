{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/dispatch?__path=/$1"
    }
  ],
  "functions": {
    "api/dispatch.js": {
      "includeFiles": "{*.html,*.css,*.js,*.png,*.jpg,assets/**}",
      "maxDuration": 60
    }
  }
}
